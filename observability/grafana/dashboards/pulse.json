{
  "title": "Pulse",
  "uid": "pulse-eng",
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "id": 1,
      "title": "Checks / second by status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "sum by (status) (rate(monitor_checks_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Process duration p50 / p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(monitor_process_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(monitor_process_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue depth + inflight",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "max(queue_depth)",
          "legendFormat": "queue depth"
        },
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "sum(worker_jobs_inflight)",
          "legendFormat": "inflight"
        }
      ]
    },
    {
      "id": 4,
      "title": "Scheduler: enqueued vs skipped (dedup)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "sum(rate(scheduler_enqueued_total[1m]))",
          "legendFormat": "enqueued"
        },
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "sum(rate(scheduler_skipped_total[1m]))",
          "legendFormat": "skipped"
        }
      ]
    },
    {
      "id": 5,
      "title": "Incidents opened vs resolved",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "sum(rate(incidents_opened_total[5m]))",
          "legendFormat": "opened"
        },
        {
          "datasource": {
            "uid": "prom"
          },
          "expr": "sum(rate(incidents_resolved_total[5m]))",
          "legendFormat": "resolved"
        }
      ]
    }
  ]
}