 "item": [
  {
   "name": "health",
   "request": {
    "method": "GET",
    "url": "{{baseUrl}}/health"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200))"
      ]
     }
    }
   ]
  },
  {
   "name": "v1 health",
   "request": {
    "method": "GET",
    "url": "{{baseUrl}}/api/v1/health"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('healthy', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('healthy'); })"
      ]
     }
    }
   ]
  },
  {
   "name": "register",
   "request": {
    "method": "POST",
    "url": "{{baseUrl}}/api/v1/auth/register",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "body": {
     "mode": "raw",
     "raw": "{\"email\":\"qa{{$timestamp}}@pulse.local\",\"password\":\"qa123456\",\"name\":\"QA\"}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('registered', () => { pm.response.to.have.status(200); pm.collectionVariables.set('token', pm.response.json().data.token); })"
      ]
     }
    }
   ]
  },
