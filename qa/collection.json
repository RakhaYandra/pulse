     }
    ],
    "url": "{{baseUrl}}/api/v1/reports/reliability?days=30"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('report 200 + shape', () => { pm.response.to.have.status(200); const r = pm.response.json().data[0]; pm.expect(r).to.have.property('monitor_id'); pm.expect(r).to.have.property('mttr_seconds'); pm.expect(r).to.have.property('uptime_pct'); })"
