PORT=8080
DATABASE_URL=postgres://pulse:pulsepass@postgres:5432/pulse?sslmode=disable
REDIS_ADDR=redis:6379
JWT_SECRET=change-me-in-production
# Comma-separated CORS origins. "*" allowed only if set explicitly (never default).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Hostnames exempt from SSRF IP filtering (bench stub on Docker DNS). Empty = strict.
PULSE_ALLOW_HOSTS=
# Grafana dev login (observability profile). Override in production.
GF_SECURITY_ADMIN_PASSWORD=pulse
LOG_LEVEL=info
# Telegram (MVP: notify on incident OPEN/RESOLVED only). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
